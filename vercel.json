{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": null,
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/invoice-icon.svg",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
